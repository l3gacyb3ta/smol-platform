# Hack Club OIDC — register your app at auth.hackclub.com
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

# NextAuth — generate with: openssl rand -hex 32
AUTH_SECRET=

# Airtable — from airtable.com/create/tokens
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Programs
AIRTABLE_SUBMISSIONS_TABLE=Submissions

# Slack — bot token with channels:manage scope
SLACK_BOT_TOKEN=

# Set to "enabled" to let spin-up create real channels in the workspace.
# Left unset, the Slack step is labelled as an admin task and nothing is created.
SLACK_CHANNEL_CREATION=

# GitHub — fine-grained PAT that can generate repos in the hackclub-smol org
GITHUB_TOKEN=

# Comma-separated Slack user IDs who can accept programs and review submissions
ADMIN_SLACK_IDS=

# The build shown in the edition line in every footer. Optional — falls back to
# CF_PAGES_COMMIT_SHA / VERCEL_GIT_COMMIT_SHA, then to "dev". Set it explicitly
# if you want the revision to appear on client-rendered pages too:
#   NEXT_PUBLIC_BUILD_REV=$CF_PAGES_COMMIT_SHA
NEXT_PUBLIC_BUILD_REV=
